# Workflow: frontend extract, pull and compile (from repository root)
# Requires an authenticated Transifex CLI.
# 1) $ npm ci
# 2) $ npm run extract_messages
# 3) $ tx pull -a
# 4) $ npm run compile_catalog

# Optional workflow: push extracted sources (from repository root)
# 1) $ tx push -s

# Add languages in Transifex, then pull.
# Optional: local frontend language (development only, from repository root)
# 1) $ npm ci
# 2) $ npm run init_catalog lang <lang>
# 3) $ npm run extract_messages
# 4) Translate the PO file, then compile:
#    $ npm run compile_catalog lang <lang>

[main]
host = https://app.transifex.com

[o:inveniosoftware:p:invenio:r:react-searchkit-messages-ui]
file_filter = src/lib/translations/messages/<lang>/messages.po
source_file = src/lib/translations/translations.pot
source_lang = en
type = PO
