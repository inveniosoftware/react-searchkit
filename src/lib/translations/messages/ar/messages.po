msgid "Type something"
msgstr "أرقن شيء"

msgid "Search"
msgstr "بحث"

msgid "No results found!"
msgstr "لا توجد نتائج!"

msgid "Current search {{- search}}"
msgstr "البحث الحالي {{- search}}"

msgid "Clear query"
msgstr "محو الطّلب"

msgid "Oops! Something went wrong while fetching results."
msgstr "عفوا!  حدث خطأ أثناء جلب النتائج."

msgid "e.g. 2025 or 2025-03-15"
msgstr "مثال 2025 أو 2025-03-15"

msgid "Enter at least one value"
msgstr " أدخل قيمة واحدة على الأقل."

msgid "Year must be 4 digits"
msgstr " يجب أن تتكوّن السنة من 4 أرقام."

msgid "Invalid date"
msgstr " تاريخ غير صالح."

msgid "Invalid number"
msgstr " رقم غير صالح."

msgid "Start must be before end"
msgstr " يجب أن يكون تاريخ البداية قبل تاريخ النهاية."

msgid "to"
msgstr "إلى"

msgid "Apply custom range"
msgstr " تطبيق الفترة المخصّصة"

msgid "Custom range"
msgstr " الفترة المخصّصة"

msgid "From"
msgstr "من"

msgid "To"
msgstr "إلى"

msgid "Results per page"
msgstr "عدد النتائج في الصّفحة"

msgid "Sort"
msgstr "رتّب"

msgid "Sort Results By"
msgstr "رتّب نتائج البحث حسب"

msgid "Sort Order"
msgstr " ترتيب النتائج"
